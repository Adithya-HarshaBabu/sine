# Spotify: create an app at https://developer.spotify.com/dashboard
# and add http://127.0.0.1:5173/ as a Redirect URI (Web API + Web Playback SDK).
# Optional: Sine's own Client ID is built in; set this to use your own Spotify app.
VITE_SPOTIFY_CLIENT_ID=

# Assistant. Server-side only: never give these a VITE_ prefix, which would publish them in the site's code.
# Create a free key at https://aistudio.google.com.
GEMINI_API_KEY=
# Optional: use a different Gemini model.
GEMINI_MODEL=
# Optional: comma-separated Spotify user IDs allowed to use the assistant.
ASSISTANT_ALLOWED_USERS=
